
---
import { services } from "../../data/services";
---

<section class="services-section" id="services">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="section-label">WHAT WE BRING TO THE TABLE</p>
        <h2>
          The right tools.
          <span>The right thinking.</span>
        </h2>
      </div>

      <p class="section-intro">
        Different capabilities, one shared purpose: helping
        businesses communicate better, connect with people
        and move forward.
      </p>
    </div>

    <div class="services-list">
      {services.map((service) => (
        <article class="service-item">
          <span class="service-number">{service.number}</span>

          <div class="service-content">
            <p class="service-category">{service.category}</p>
            <h3>{service.title}</h3>
            <p class="service-description">{service.description}</p>
          </div>

          <span class="service-mark" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: var(--color-paper-deep);
    border-top: 1px solid var(--color-line);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: end;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .section-heading h2 {
    max-width: 700px;
    margin-bottom: 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
  }

  .section-heading h2 span {
    display: block;
    color: var(--color-accent);
    font-style: italic;
  }

  .section-intro {
    max-width: 410px;
    margin-bottom: 0.4rem;
    font-size: var(--text-lg);
  }

  .services-list {
    border-top: 1px solid var(--color-line);
  }

  .service-item {
    display: grid;
    grid-template-columns: 70px 1fr 40px;
    gap: 1.5rem;
    align-items: start;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--color-line);
    transition: padding var(--transition-normal);
  }

  .service-number {
    padding-top: 0.2rem;
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1.2rem;
  }

  .service-category {
    margin-bottom: 0.8rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .service-content h3 {
    margin-bottom: 0.8rem;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
  }

  .service-description {
    max-width: 650px;
    margin-bottom: 0;
  }

  .service-mark {
    color: var(--color-accent);
    font-size: 1.5rem;
    transition: transform var(--transition-fast);
  }

  .service-item:hover .service-mark {
    transform: translate(4px, -4px);
  }

  @media (max-width: 700px) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }

    .service-item {
      grid-template-columns: 35px 1fr 20px;
      gap: 0.75rem;
      padding-block: 1.8rem;
    }

    .service-description {
      font-size: var(--text-sm);
    }
  }
</style>
