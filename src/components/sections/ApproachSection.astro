
---
const principles = [
  {
    number: "01",
    title: "Attention",
    description:
      "Give people a reason to notice. We create digital experiences and content that communicate clearly and make the right first impression.",
  },
  {
    number: "02",
    title: "Trust",
    description:
      "Give people reasons to believe. Clear messaging, thoughtful design and useful information help turn curiosity into confidence.",
  },
  {
    number: "03",
    title: "Action",
    description:
      "Make the next step obvious. Whether it is making an enquiry, requesting a quote or starting a conversation, we help remove the guesswork.",
  },
];
---

<section class="approach-section" aria-labelledby="approach-heading">
  <div class="container">
    <div class="approach-intro">
      <p class="section-label">HOW WE THINK</p>

      <h2 id="approach-heading">
        Good digital experiences move people.
        <em>We think about what moves them.</em>
      </h2>

      <p class="approach-description">
        Getting noticed is a start. Building confidence matters.
        Making the next step clear is where the experience comes together.
      </p>
    </div>

    <div class="principles">
      {principles.map((principle) => (
        <article class="principle">
          <span class="principle-number">{principle.number}</span>

          <div>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </div>

          <span class="principle-arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>

    <p class="approach-note">
      ATTENTION <span>·</span> TRUST <span>·</span> ACTION
    </p>
  </div>
</section>

<style>
  .approach-section {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .approach-section .section-label {
    color: #c5bbb0;
  }

  .approach-intro {
    max-width: 850px;
    margin-bottom: 4rem;
  }

  .approach-intro h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.08;
  }

  .approach-intro h2 em {
    display: block;
    margin-top: 0.3em;
    color: #e16a3e;
    font-weight: 400;
  }

  .approach-description {
    max-width: 620px;
    color: #c5bbb0;
    font-size: var(--text-lg);
  }

  .principles {
    border-top: 1px solid #49423c;
  }

  .principle {
    display: grid;
    grid-template-columns: 70px 1fr 40px;
    gap: 1.5rem;
    align-items: start;
    padding-block: 2.5rem;
    border-bottom: 1px solid #49423c;
  }

  .principle-number {
    color: #e16a3e;
    font-family: var(--font-heading);
    font-size: 1.2rem;
  }

  .principle h3 {
    margin-bottom: 0.75rem;
    color: var(--color-paper);
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .principle p {
    max-width: 650px;
    margin-bottom: 0;
    color: #c5bbb0;
  }

  .principle-arrow {
    color: #e16a3e;
    font-size: 1.5rem;
  }

  .approach-note {
    margin-top: 2rem;
    margin-bottom: 0;
    color: #c5bbb0;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
  }

  .approach-note span {
    padding-inline: 0.5rem;
    color: #e16a3e;
  }

  @media (max-width: 600px) {
    .principle {
      grid-template-columns: 35px 1fr 20px;
      gap: 0.75rem;
      padding-block: 2rem;
    }
  }
</style>
