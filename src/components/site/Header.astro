---
import logoPrimary from "../../assets/swishhub-logo-primary.png";
import logoReversed from "../../assets/swishhub-logo-reversed.png";
import { site } from "../../data/site";

const currentPath = Astro.url.pathname;


  const navigation = [
  { label: "Home", href: "/", path: "/" },
  { label: "Services", href: "/services/", path: "/services/" },
  { label: "Blog", href: "/blog/", path: "/blog/" },
  { label: "About", href: "/about/", path: "/about/" },
  { label: "Contact", href: "/contact/", path: "/contact/" },
];
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="SwishHub home">
      <img
        class="logo-primary"
        src={logoPrimary.src}
        alt="SwishHub Interactive Limited"
        width="220"
        height="60"
      />
      <img
        class="logo-reversed"
        src={logoReversed.src}
        alt="SwishHub Interactive Limited"
        width="220"
        height="60"
      />
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={item.path && currentPath === item.path ? "page" : undefined}
          class:list={[
            "nav-link",
            { "is-active": item.path && currentPath === item.path },
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      class="header-cta"
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Start a project <span aria-hidden="true">↗</span>
    </a>

    <details class="mobile-menu">
      <summary aria-label="Toggle navigation menu">
        <span class="menu-open">Menu</span>
        <span class="menu-close">Close</span>
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </summary>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={item.path && currentPath === item.path ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}

        <a
          class="mobile-cta"
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Start a project ↗
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");

  if (header) {
    let ticking = false;

    const getEffectiveBg = (el: Element | null): string => {
      let current: Element | null = el;
      while (current && current !== document.documentElement) {
        const bg = window.getComputedStyle(current).backgroundColor;
        if (bg && bg !== "rgba(0, 0, 0, 0)" && bg !== "transparent") {
          return bg;
        }
        current = current.parentElement;
      }
      return "rgb(245, 241, 234)";
    };

    const isDarkColor = (rgbString: string): boolean => {
      const match = rgbString.match(/\d+/g);
      if (!match || match.length < 3) return false;
      const [r, g, b] = match.map(Number);
      // Perceived luminance formula
      const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
      return luminance < 0.55;
    };

    const updateHeaderSurface = () => {
      const rect = header.getBoundingClientRect();
      const probeY = rect.bottom + 4;
      const probeX = window.innerWidth / 2;

      const target = document.elementFromPoint(probeX, probeY);
      const section = target?.closest("section, footer") || document.body;
      const bgColor = getEffectiveBg(section);

      header.style.backgroundColor = bgColor;
      header.classList.toggle("is-dark-surface", isDarkColor(bgColor));
      ticking = false;
    };

    const onScrollOrResize = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeaderSurface);
        ticking = true;
      }
    };

    window.addEventListener("scroll", onScrollOrResize, { passive: true });
    window.addEventListener("resize", onScrollOrResize, { passive: true });
    updateHeaderSurface();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-line);
    background-color: var(--color-paper);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      color 0.35s ease;
  }

  .header-inner {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
  }

  .brand img {
    display: block;
    width: auto;
    height: 48px;
    max-width: 190px;
    object-fit: contain;
  }

  .logo-reversed {
    display: none;
  }

  /* Automatic contrast switch over dark / burnt-orange sections */
  .site-header.is-dark-surface {
    border-bottom-color: rgba(245, 241, 234, 0.25);
  }

  .site-header.is-dark-surface .logo-primary {
    display: none;
  }

  .site-header.is-dark-surface .logo-reversed {
    display: block;
  }

  @media (max-width: 760px) {
    .brand img {
      height: 42px;
      max-width: 165px;
    }
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.5rem);
  }

  .nav-link {
    position: relative;
    padding-block: 0.5rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-ink);
  }

  .site-header.is-dark-surface .nav-link {
    color: rgba(245, 241, 234, 0.82);
  }

  .site-header.is-dark-surface .nav-link:hover,
  .site-header.is-dark-surface .nav-link.is-active {
    color: var(--color-paper);
  }

  .nav-link.is-active::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    content: "";
  }

  .site-header.is-dark-surface .nav-link.is-active::after {
    background: var(--color-paper);
  }

  .header-cta,
  .mobile-cta {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: var(--color-ink);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .header-cta:hover,
  .mobile-cta:hover {
    background: var(--color-accent);
  }

  .site-header.is-dark-surface .header-cta {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .site-header.is-dark-surface .header-cta:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: 76px;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-menu {
      position: relative;
      display: block;
    }

    .mobile-menu summary {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
      list-style: none;
      color: var(--color-ink);
      font-size: var(--text-sm);
      font-weight: 600;
    }

    .site-header.is-dark-surface .mobile-menu summary {
      color: var(--color-paper);
    }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .menu-close {
      display: none;
    }

    .mobile-menu[open] .menu-open {
      display: none;
    }

    .mobile-menu[open] .menu-close {
      display: inline;
    }

    .menu-icon {
      display: flex;
      width: 22px;
      flex-direction: column;
      gap: 6px;
    }

    .menu-icon span {
      width: 100%;
      height: 1px;
      background: var(--color-ink);
    }

    .site-header.is-dark-surface .menu-icon span {
      background: var(--color-paper);
    }

    .mobile-nav {
      position: absolute;
      top: calc(100% + 1.2rem);
      right: calc(var(--page-gutter) * -1);
      left: auto;
      display: flex;
      width: min(100vw, 380px);
      flex-direction: column;
      gap: 0;
      padding: 1.5rem var(--page-gutter) 2rem;
      border-top: 1px solid var(--color-line);
      border-bottom: 1px solid var(--color-line);
      background: var(--color-paper);
      color: var(--color-ink);
      box-shadow: 0 16px 30px rgb(23 19 15 / 8%);
    }

    .mobile-nav > a:not(.mobile-cta) {
      padding-block: 1rem;
      border-bottom: 1px solid var(--color-line);
      font-family: var(--font-heading);
      font-size: 1.5rem;
    }

    .mobile-nav .mobile-cta {
      margin-top: 1.5rem;
    }
  }
</style>