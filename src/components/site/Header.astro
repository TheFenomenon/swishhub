
---
import logo from "../../assets/swishhub-logo-primary.png";
import { site } from "../../data/site";

const currentPath = Astro.url.pathname;

const navigation = [
  { label: "Home", href: "/", path: "/" },
  { label: "Services", href: "/services/", path: "/services/" },
  { label: "About", href: "/about/", path: "/about/" },
  { label: "Contact", href: "/#contact", path: "" },
];
---

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="SwishHub home">
  <img
    src={logo.src}
    alt="SwishHub Interactive Limited"
    width="220"
    height="60"
  />
</a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={item.path && currentPath === item.path ? "page" : undefined}
          class:list={[
            "nav-link",
            { "is-active": item.path && currentPath === item.path },
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      class="header-cta"
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Start a project <span aria-hidden="true">↗</span>
    </a>

    <details class="mobile-menu">
      <summary aria-label="Toggle navigation menu">
        <span class="menu-open">Menu</span>
        <span class="menu-close">Close</span>
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </summary>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={item.path && currentPath === item.path ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}

        <a
          class="mobile-cta"
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Start a project ↗
        </a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .header-inner {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
}

.brand img {
  display: block;
  width: auto;
  height: 48px;
  max-width: 190px;
  object-fit: contain;
}

@media (max-width: 760px) {
  .brand img {
    height: 42px;
    max-width: 165px;
  }
}

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.5rem);
  }

  .nav-link {
    position: relative;
    padding-block: 0.5rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-ink);
  }

  .nav-link.is-active::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    content: "";
  }

  .header-cta,
  .mobile-cta {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: var(--color-ink);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background var(--transition-fast);
  }

  .header-cta:hover,
  .mobile-cta:hover {
    background: var(--color-accent);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: 76px;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-menu {
      position: relative;
      display: block;
    }

    .mobile-menu summary {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
      list-style: none;
      color: var(--color-ink);
      font-size: var(--text-sm);
      font-weight: 600;
    }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .menu-close {
      display: none;
    }

    .mobile-menu[open] .menu-open {
      display: none;
    }

    .mobile-menu[open] .menu-close {
      display: inline;
    }

    .menu-icon {
      display: flex;
      width: 22px;
      flex-direction: column;
      gap: 6px;
    }

    .menu-icon span {
      width: 100%;
      height: 1px;
      background: var(--color-ink);
    }

    .mobile-nav {
      position: absolute;
      top: calc(100% + 1.5rem);
      right: calc(var(--page-gutter) * -1);
      left: auto;
      display: flex;
      width: min(100vw, 380px);
      flex-direction: column;
      gap: 0;
      padding: 1.5rem var(--page-gutter) 2rem;
      border-top: 1px solid var(--color-line);
      border-bottom: 1px solid var(--color-line);
      background: var(--color-paper);
      box-shadow: 0 16px 30px rgb(23 19 15 / 8%);
    }

    .mobile-nav > a:not(.mobile-cta) {
      padding-block: 1rem;
      border-bottom: 1px solid var(--color-line);
      font-family: var(--font-heading);
      font-size: 1.5rem;
    }

    .mobile-nav .mobile-cta {
      margin-top: 1.5rem;
    }
  }
</style>
