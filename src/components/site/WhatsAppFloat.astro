---
import { site } from "../../data/site";

const pathname = Astro.url.pathname;

let greeting = "Hi there! Have a quick question about building or growing your business online?";
let prefill = "Hello SwishHub, I'd like to discuss a project.";

if (pathname.startsWith("/services")) {
  greeting = "Need help picking the right package or scope for your budget?";
  prefill = "Hello SwishHub, I'm looking at your services and need help choosing the right scope.";
} else if (pathname.startsWith("/work")) {
  greeting = "Want a similar conversion-focused setup for your own business?";
  prefill = "Hello SwishHub, I just checked your work showcase and want to discuss a similar build.";
} else if (pathname.startsWith("/blog")) {
  greeting = "Want us to apply these strategies directly to your website or sales funnel?";
  prefill = "Hello SwishHub, I was reading your blog and want to talk about implementing this.";
} else if (pathname.startsWith("/contact")) {
  greeting = "Prefer a quick chat instead of filling out the brief? Message us directly.";
  prefill = "Hello SwishHub, I'm on your contact page and would like to chat directly.";
}

const whatsappLink = `${site.whatsappUrl}?text=${encodeURIComponent(prefill)}`;
---

<div class="wa-float" id="waFloat" data-greeting={greeting}>
  <div class="wa-popup" id="waPopup" role="dialog" aria-label="WhatsApp assistant">
    <button type="button" class="wa-close" id="waClose" aria-label="Close message">×</button>
    <div class="wa-popup-header">
      <span class="wa-dot"></span>
      <strong>SwishHub Desk</strong>
    </div>
    <p class="wa-popup-text">{greeting}</p>
    <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="wa-popup-cta">
      Chat on WhatsApp <span>↗</span>
    </a>
  </div>

  <a
    href={whatsappLink}
    target="_blank"
    rel="noopener noreferrer"
    class="wa-trigger"
    id="waTrigger"
    aria-label="Chat with SwishHub on WhatsApp"
  >
    <svg viewBox="0 0 32 32" width="24" height="24" fill="currentColor" aria-hidden="true">
      <path d="M16.004 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.256.59 4.46 1.71 6.404L3.1 29.02l6.79-1.78a12.74 12.74 0 0 0 6.114 1.56h.006c7.058 0 12.798-5.74 12.798-12.8 0-3.42-1.332-6.636-3.75-9.054A12.715 12.715 0 0 0 16.004 3.2zm0 23.43h-.004a10.6 10.6 0 0 1-5.404-1.48l-.388-.23-4.03 1.056 1.076-3.928-.252-.402a10.58 10.58 0 0 1-1.624-5.646c0-5.858 4.766-10.624 10.63-10.624 2.838 0 5.506 1.106 7.512 3.114a10.556 10.556 0 0 1 3.11 7.514c0 5.86-4.768 10.626-10.626 10.626zm5.828-7.958c-.32-.16-1.89-.932-2.182-1.038-.292-.106-.506-.16-.718.16-.214.32-.826 1.038-1.012 1.252-.186.212-.372.24-.692.08-.32-.16-1.35-.498-2.572-1.588-.95-.848-1.592-1.894-1.778-2.214-.186-.32-.02-.492.14-.652.144-.144.32-.372.48-.558.16-.186.212-.32.32-.532.106-.214.052-.4-.028-.558-.08-.16-.718-1.732-.984-2.37-.26-.622-.524-.538-.718-.548l-.612-.01c-.214 0-.56.08-.852.4-.294.32-1.118 1.092-1.118 2.664s1.144 3.09 1.304 3.304c.16.212 2.252 3.438 5.456 4.822.762.328 1.356.524 1.82.672.764.242 1.46.208 2.01.126.614-.092 1.89-.772 2.156-1.518.266-.746.266-1.384.186-1.518-.08-.134-.292-.214-.612-.372z" />
    </svg>
  </a>
</div>

<style>
  .wa-float {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .wa-trigger {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #1f7a4c;
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .wa-trigger:hover {
    transform: translateY(-2px);
    background: #18633d;
  }

  .wa-popup {
    width: 300px;
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    padding: 1.1rem 1.15rem;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.14);
    position: relative;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .wa-popup.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .wa-close {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    background: none;
    border: none;
    font-size: 1.2rem;
    line-height: 1;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0.2rem;
  }

  .wa-popup-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    margin-bottom: 0.45rem;
  }

  .wa-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1f7a4c;
  }

  .wa-popup-text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-muted);
    margin: 0 0 0.85rem;
  }

  .wa-popup-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    color: #1f7a4c;
    text-decoration: none;
  }

  .wa-popup-cta:hover {
    text-decoration: underline;
  }

  /* Mobile: smaller footprint + hidden until user scrolls up */
  @media (max-width: 768px) {
    .wa-float {
      bottom: 1rem;
      right: 1rem;
      gap: 0.55rem;
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
    }

    .wa-float.is-mobile-visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .wa-trigger {
      width: 46px;
      height: 46px;
    }

    .wa-trigger svg {
      width: 20px;
      height: 20px;
    }

    .wa-popup {
      width: min(265px, calc(100vw - 2rem));
      padding: 0.85rem 0.95rem;
    }

    .wa-popup-text {
      font-size: 0.84rem;
      margin-bottom: 0.65rem;
    }
  }
</style>

<script>
  const waFloat = document.getElementById("waFloat");
  const waPopup = document.getElementById("waPopup");
  const waClose = document.getElementById("waClose");

  const isMobile = () => window.innerWidth <= 768;
  let popupShown = false;
  let popupDismissed = sessionStorage.getItem("waPopupDismissed") === "true";

  function playSoftChime() {
    try {
      const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      const ctx = new AudioCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
      osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.14); // A5
      gain.gain.setValueAtTime(0.001, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.04, ctx.currentTime + 0.03);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.28);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.3);
    } catch {
      // Ignore if browser blocks autoplay audio before interaction
    }
  }

  function openGreeting() {
    if (popupShown || popupDismissed || !waPopup) return;
    popupShown = true;
    waPopup.classList.add("is-open");
    playSoftChime();
  }

  // Desktop: show delayed popup after 4 seconds
  if (!isMobile()) {
    window.setTimeout(openGreeting, 4000);
  }

  // Mobile: reveal only when scrolling up (after passing hero) or near page bottom
  let lastScrollY = window.scrollY;
  let scrollUpDistance = 0;

  window.addEventListener(
    "scroll",
    () => {
      if (!isMobile() || !waFloat) return;

      const currentY = window.scrollY;
      const delta = lastScrollY - currentY;
      const nearBottom =
        window.innerHeight + currentY >= document.documentElement.scrollHeight - 120;

      if (currentY < 100 && !nearBottom) {
        waFloat.classList.remove("is-mobile-visible");
        waPopup?.classList.remove("is-open");
        scrollUpDistance = 0;
      } else if (delta > 0) {
        // Scrolling up
        scrollUpDistance += delta;
        if (scrollUpDistance > 40) {
          waFloat.classList.add("is-mobile-visible");
          openGreeting();
        }
      } else if (delta < -12 && !nearBottom) {
        // Scrolling down: hide cleanly so reading view is unobstructed
        scrollUpDistance = 0;
        waFloat.classList.remove("is-mobile-visible");
        waPopup?.classList.remove("is-open");
      }

      if (nearBottom) {
        waFloat.classList.add("is-mobile-visible");
        openGreeting();
      }

      lastScrollY = currentY;
    },
    { passive: true }
  );

  waClose?.addEventListener("click", () => {
    popupDismissed = true;
    sessionStorage.setItem("waPopupDismissed", "true");
    waPopup?.classList.remove("is-open");
  });
</script>