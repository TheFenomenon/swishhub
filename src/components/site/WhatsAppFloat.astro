---
import { site } from "../../data/site";
---

<aside aria-label="Quick contact" class="whatsapp-float-wrapper">
  <a
    id="whatsapp-float-btn"
    href={site.whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-float"
    aria-label="Chat with SwishHub on WhatsApp"
  >
    <svg class="whatsapp-svg" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span class="float-text">Let's talk</span>
    <span class="float-arrow" aria-hidden="true">↗</span>
  </a>
</aside>

<script>
  import { site } from "../../data/site";

  const btn = document.getElementById("whatsapp-float-btn") as HTMLAnchorElement;

  if (btn) {
    const path = window.location.pathname;
    let message = "Hello SwishHub, I'd like to discuss a project.";

    if (path.includes("/services/web-design-and-development")) {
      message = "Hello SwishHub, I'd like to discuss your Web design & development service.";
    } else if (path.includes("/services/content-writing")) {
      message = "Hello SwishHub, I'd like to discuss your Content writing service.";
    } else if (path.includes("/services/social-media-management")) {
      message = "Hello SwishHub, I'd like to discuss your Social media management service.";
    } else if (path.includes("/services/youtube-optimisation-and-automation")) {
      message = "Hello SwishHub, I'd like to discuss your YouTube optimisation & automation service.";
    } else if (path.includes("/services/ai-assisted-video-content")) {
      message = "Hello SwishHub, I'd like to discuss your AI-assisted video content service.";
    } else if (path.includes("/services/custom-t-shirts-and-stationery")) {
      message = "Hello SwishHub, I'd like to discuss your Custom T-shirts & stationery service.";
    } else if (path.includes("/services")) {
      message = "Hello SwishHub, I'd like to explore your services.";
    } else if (path.includes("/about")) {
      message = "Hello SwishHub, I'd like to learn more about your company and approach.";
    }

    const targetUrl = `${site.whatsappUrl}?text=${encodeURIComponent(message)}`;
    btn.href = targetUrl;
  }
</script>

<style>
  .whatsapp-float-wrapper {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 999;
  }

  .whatsapp-float {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.35rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-line);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    box-shadow: 0 12px 32px rgb(23 19 15 / 15%);
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast), border-color var(--transition-fast);
  }

  .whatsapp-float:hover {
    background: var(--color-accent);
    color: var(--color-white);
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .whatsapp-svg {
    flex-shrink: 0;
  }

  .float-arrow {
    color: inherit;
    transition: transform var(--transition-fast);
  }

  .whatsapp-float:hover .float-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 600px) {
    .whatsapp-float-wrapper {
      bottom: 1.25rem;
      right: 1.25rem;
    }

    .whatsapp-float {
      padding: 0.75rem 1.1rem;
      font-size: 0.9rem;
    }
  }
</style>