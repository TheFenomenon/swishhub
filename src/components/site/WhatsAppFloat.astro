---
import { site } from "../../data/site";
---

<div id="whatsapp-widget" class="whatsapp-float is-hidden" aria-live="polite">
  <button id="whatsapp-toggle" class="whatsapp-button" aria-label="Open chat assistant">
    <!-- WhatsApp Icon SVG -->
    <svg class="wa-icon" viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span class="pulse-ring"></span>
    <span class="notification-badge">1</span>
  </button>

  <div id="whatsapp-chatbox" class="chatbox is-closed">
    <div class="chatbox-header">
      <div class="agent-info">
        <span class="status-dot"></span>
        <div>
          <h4>SwishHub Assistant</h4>
          <p>Typically replies instantly</p>
        </div>
      </div>
      <button id="chatbox-close" class="close-btn" aria-label="Close chat">×</button>
    </div>

    <div class="chatbox-body">
      <div class="message-bubble bot-msg">
        <p id="dynamic-greeting">Hello! Exploring our digital services today? Let me know what you're building or if you'd prefer to connect directly with our lead strategist on WhatsApp.</p>
      </div>
    </div>

    <div class="chatbox-footer">
      <a id="whatsapp-action-link" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="button wa-chat-btn">
        <span>Chat on WhatsApp</span> <span>↗</span>
      </a>
      <p class="human-note">You'll be connected straight to Mever Daveed.</p>
    </div>
  </div>
</div>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 999;
    font-family: inherit;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .whatsapp-float.is-hidden {
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }

  /* Main Trigger Button */
  .whatsapp-button {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #25D366;
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.35);
    position: relative;
    transition: transform var(--transition-fast);
  }

  .whatsapp-button:hover {
    transform: scale(1.08);
  }

  .notification-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-paper);
  }

  .pulse-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid #25D366;
    animation: pulse 2s infinite;
    opacity: 0;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* Chatbox Popup Card */
  .chatbox {
    position: absolute;
    bottom: 75px;
    right: 0;
    width: 340px;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    box-shadow: 0 15px 40px rgba(23, 19, 15, 0.15);
    border-radius: 4px;
    overflow: hidden;
    transform-origin: bottom right;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chatbox.is-closed {
    opacity: 0;
    transform: scale(0.95) translateY(10px);
    pointer-events: none;
  }

  .chatbox-header {
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .agent-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    background: #25D366;
    border-radius: 50%;
    box-shadow: 0 0 8px #25D366;
  }

  .agent-info h4 {
    font-size: 0.95rem;
    margin: 0;
    color: var(--color-paper);
  }

  .agent-info p {
    font-size: 0.75rem;
    color: var(--color-line);
    margin: 0;
    opacity: 0.8;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--color-paper);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }

  .close-btn:hover {
    opacity: 1;
  }

  .chatbox-body {
    padding: 1.25rem;
  }

  .message-bubble {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    padding: 0.85rem 1rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .chatbox-footer {
    padding: 0 1.25rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .wa-chat-btn {
    width: 100%;
    justify-content: center;
    background: #25D366 !important;
    color: #fff !important;
    border: none !important;
    font-size: 0.9rem;
    padding: 0.75rem;
  }

  .wa-chat-btn:hover {
    background: #22bf5b !important;
  }

  .human-note {
    font-size: 0.75rem;
    color: var(--color-muted);
    text-align: center;
    margin: 0;
  }

  @media (max-width: 480px) {
    .chatbox {
      width: calc(100vw - 3rem);
      right: -1rem;
    }
  }
</style>

<script define:vars={{ whatsappBaseUrl: site.whatsappUrl }}>
  function playNotificationSound() {
    try {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = "sine";
      osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // D5 note
      osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.08); // A5 note

      gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + 0.3);
    } catch (e) {
      // AudioContext blocked before user interaction; ignore silently
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const widget = document.getElementById("whatsapp-widget");
    const toggleBtn = document.getElementById("whatsapp-toggle");
    const chatbox = document.getElementById("chatbox-chatbox") || document.getElementById("whatsapp-chatbox");
    const closeBtn = document.getElementById("chatbox-close");
    const greetingEl = document.getElementById("dynamic-greeting");
    const actionLink = document.getElementById("whatsapp-action-link");

    if (!widget || !toggleBtn || !chatbox) return;

    // Context-aware greetings and WhatsApp pre-filled messages
    const path = window.location.pathname;
    let greetingText = "Hello! Exploring our digital services today? Let me know what you're building or if you'd prefer to connect directly with our lead strategist on WhatsApp.";
    let waMessage = "Hello SwishHub, I'm visiting your website and would like to chat with a human about a project.";

    if (path.includes("/services/")) {
      greetingText = "Looking over our service scopes and pricing? Feel free to ask a question or tap below to discuss your exact requirements with a human.";
      waMessage = "Hello SwishHub, I was reviewing your services on your website and would like to discuss a project.";
    } else if (path.includes("/contact")) {
      greetingText = "Ready to start your brief? You can fill out the form or chat directly with our team on WhatsApp right now.";
      waMessage = "Hello SwishHub, I'm on your contact page and would like to speak directly with someone.";
    } else if (path.includes("/blog")) {
      greetingText = "Enjoying our editorial insights? Let's discuss how we can apply these strategies to your business.";
      waMessage = "Hello SwishHub, I was reading your blog and would like to talk with a human.";
    } else if (path.includes("/about")) {
      greetingText = "Curious about our philosophy and team? Let's chat about how we can help your brand stand out.";
      waMessage = "Hello SwishHub, I was reading about your agency and want to connect with a human.";
    }

    if (greetingEl) greetingEl.textContent = greetingText;
    if (actionLink) actionLink.href = `${whatsappBaseUrl}?text=${encodeURIComponent(waMessage)}`;

    // 1. Reveal widget and pop open chatbox after 4 seconds with sound
    setTimeout(() => {
      widget.classList.remove("is-hidden");
      chatbox.classList.remove("is-closed");
      playNotificationSound();
    }, 4000);

    // 2. Toggle chatbox open/closed on button click
    toggleBtn.addEventListener("click", () => {
      chatbox.classList.toggle("is-closed");
    });

    // 3. Close chatbox
    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        chatbox.classList.add("is-closed");
      });
    }
  });
</script>