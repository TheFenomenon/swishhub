---
import { site } from "../../data/site";
import logoReversed from "../../assets/swishhub-logo-reversed.png";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-brand-logo" aria-label="SwishHub home">
          <img
            src={logoReversed.src}
            alt="SwishHub Interactive Limited"
            width="200"
            height="55"
          />
        </a>
        <p>{site.tagline}</p>
      </div>

      <div class="footer-contact">
        <span class="footer-label">HAVE A PROJECT IN MIND?</span>
        <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">
          Let's talk <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} {site.legalName}. All rights reserved.</p>
      <p>Built with intention.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 1.5rem;
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 3rem;
    padding-bottom: 4rem;
  }

  .footer-brand-logo {
    display: inline-flex;
    align-items: center;
  }

  .footer-brand-logo img {
    display: block;
    width: auto;
    height: 40px;
    max-width: 170px;
    object-fit: contain;
  }

  .footer-brand p {
    max-width: 340px;
    margin-top: 1rem;
    color: #c5bbb0;
  }

  .footer-label {
    display: block;
    margin-bottom: 0.75rem;
    color: #c5bbb0;
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
  }

  .footer-contact a {
    font-family: var(--font-heading);
    font-size: 1.8rem;
  }

  .footer-contact a:hover {
    color: #e16a3e;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid #49423c;
  }

  .footer-bottom p {
    margin: 0;
    color: #c5bbb0;
    font-size: var(--text-xs);
  }

  @media (max-width: 600px) {
    .footer-top,
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-top {
      gap: 2.5rem;
    }
  }
</style>