---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import { services } from "../../data/services";
---

<Layout
  title="Our Services"
  description="Explore SwishHub Interactive's digital agency services, from web design and copywriting to content systems and custom branding."
>
  <Header />

  <main id="main-content">
    <section class="services-index container">
      <div class="index-header">
        <p class="section-label">WHAT WE DO</p>
        <h1>Digital solutions designed to actually sell</h1>
        <p class="index-intro">
          Select any service below to explore our approach and customise your project scope with real-time pricing.
        </p>
      </div>

      <div class="services-grid">
        {services.map((service) => (
          <a href={`/services/${service.slug}/`} class="service-card">
            <div class="card-meta">
              <span class="service-number">{service.number}</span>
              <span class="service-category">{service.category}</span>
            </div>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
            <div class="card-footer">
              <span class="price-tag">From ₦{service.basePrice.toLocaleString()}</span>
              <span class="arrow">Configure scope ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .services-index {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .index-header {
    max-width: 800px;
    margin-bottom: 4rem;
  }

  .index-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-block: 1rem;
    letter-spacing: -0.04em;
  }

  .index-intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: 0 16px 32px rgb(23 19 15 / 6%);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .service-category {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .service-card h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .service-card p {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9rem;
  }

  .price-tag {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-ink);
  }

  .arrow {
    font-weight: 600;
    color: var(--color-accent);
  }
</style>