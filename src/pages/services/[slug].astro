---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import { services, type ServiceAddon, type ServiceItem } from "../../data/services";
import { site } from "../../data/site";

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const groupedAddons = service.addons.reduce<Record<string, ServiceAddon[]>>((acc, addon) => {
  if (!acc[addon.category]) {
    acc[addon.category] = [];
  }
  acc[addon.category].push(addon);
  return acc;
}, {});
---

<Layout title={service.title} description={service.description}>
  <Header />

  <main id="main-content">
    <section class="service-detail container">
      <div class="service-header">
        <a href="/services/" class="back-link">← All Services</a>
        <p class="section-label">CUSTOM SCOPE & PRICING CALCULATOR</p>
        <h1>{service.title}</h1>
        <p class="tagline">{service.tagline}</p>
        <p class="description">{service.description}</p>
      </div>

      <div class="calculator-layout">
        <div class="addons-column">
          <h2>Select Optional Features & Add-Ons</h2>
          <p class="addons-note">
            Base build starts at <strong>₦{service.basePrice.toLocaleString()}</strong>. Check only the extras you need.
          </p>

          {Object.entries(groupedAddons).map(([categoryName, items]) => (
            <div class="addon-group">
              <h3 class="addon-category-title">{categoryName}</h3>
              <div class="addon-list">
                {items.map((addon) => {
                  const billing = addon.billing ?? "one-time";
                  const suffix = billing === "monthly" ? "/mo" : "";
                  return (
                    <label class="addon-card">
                      <input
                        type="checkbox"
                        class="addon-checkbox"
                        value={addon.price}
                        data-billing={billing}
                        data-label={addon.label}
                      />
                      <div class="addon-content">
                        <div class="addon-top">
                          <span class="addon-title">{addon.label}</span>
                          <span class="addon-price">
                            +₦{addon.price.toLocaleString()}
                            {suffix}
                          </span>
                        </div>
                        <p class="addon-desc">{addon.description}</p>
                      </div>
                    </label>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <aside class="summary-card" aria-label="Estimated Scope Summary">
          <p class="section-label">ESTIMATED INVESTMENT</p>
          <h3>{service.title}</h3>

          <div class="price-breakdown">
            <div class="breakdown-row">
              <span>Base Website Build</span>
              <span>₦{service.basePrice.toLocaleString()}</span>
            </div>
            <div class="breakdown-row">
              <span>One-Time Add-Ons (<span id="selected-count">0</span>)</span>
              <span id="addons-total">₦0</span>
            </div>
          </div>

          <div class="total-row">
            <span>Estimated One-Time Total</span>
            <strong id="grand-total">₦{service.basePrice.toLocaleString()}</strong>
          </div>

          <div class="monthly-row">
            <span>Monthly Recurring</span>
            <strong id="monthly-total">₦0/mo</strong>
          </div>

          <ul id="selected-items-list" class="selected-list">
            <li class="empty-selection">Base package selected — toggle add-ons on the left to customize.</li>
          </ul>

          <a
            id="send-scope-btn"
            href={site.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="button scope-cta"
          >
            Send Scope via WhatsApp <span>↗</span>
          </a>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script define:vars={{ basePrice: service.basePrice, serviceTitle: service.title, whatsappBaseUrl: site.whatsappUrl }}>
  const checkboxes = Array.from(document.querySelectorAll(".addon-checkbox"));
  const countEl = document.getElementById("selected-count");
  const addonsTotalEl = document.getElementById("addons-total");
  const grandTotalEl = document.getElementById("grand-total");
  const monthlyTotalEl = document.getElementById("monthly-total");
  const listEl = document.getElementById("selected-items-list");
  const ctaEl = document.getElementById("send-scope-btn");

  const formatNaira = (amount) => `₦${Number(amount).toLocaleString("en-NG")}`;

  function updateSummary() {
    const checked = checkboxes.filter((cb) => cb.checked);

    const oneTimeChecked = checked.filter((cb) => cb.getAttribute("data-billing") !== "monthly");
    const monthlyChecked = checked.filter((cb) => cb.getAttribute("data-billing") === "monthly");

    const oneTimeAddonsSum = oneTimeChecked.reduce((sum, cb) => sum + Number(cb.value || 0), 0);
    const monthlySum = monthlyChecked.reduce((sum, cb) => sum + Number(cb.value || 0), 0);
    const grandTotal = Number(basePrice) + oneTimeAddonsSum;

    if (countEl) countEl.textContent = String(oneTimeChecked.length);
    if (addonsTotalEl) addonsTotalEl.textContent = formatNaira(oneTimeAddonsSum);
    if (grandTotalEl) grandTotalEl.textContent = formatNaira(grandTotal);
    if (monthlyTotalEl) monthlyTotalEl.textContent = `${formatNaira(monthlySum)}/mo`;

    if (listEl) {
      if (checked.length === 0) {
        listEl.innerHTML = `<li class="empty-selection">Base package selected — toggle add-ons on the left to customize.</li>`;
      } else {
        listEl.innerHTML = checked
          .map((cb) => {
            const label = cb.getAttribute("data-label") || "";
            const isMonthly = cb.getAttribute("data-billing") === "monthly";
            const priceText = `+${formatNaira(cb.value || 0)}${isMonthly ? "/mo" : ""}`;
            return `<li><span>${label}</span><strong>${priceText}</strong></li>`;
          })
          .join("");
      }
    }

    if (ctaEl) {
      const scopeLines =
        checked.length > 0
          ? checked
              .map((cb) => {
                const isMonthly = cb.getAttribute("data-billing") === "monthly";
                return `- ${cb.getAttribute("data-label")} (+${formatNaira(cb.value || 0)}${isMonthly ? "/mo" : ""})`;
              })
              .join("\n")
          : "- None selected (Base build only)";

      const message = [
        `Hello SwishHub, I'd like a quote for *${serviceTitle}*.`,
        ``,
        `Base Build: ${formatNaira(basePrice)}`,
        `Selected Options:`,
        scopeLines,
        ``,
        `*Estimated One-Time Total:* ${formatNaira(grandTotal)}`,
        ...(monthlySum > 0 ? [`*Monthly Recurring:* ${formatNaira(monthlySum)}/mo`] : []),
      ].join("\n");

      ctaEl.href = `${whatsappBaseUrl}?text=${encodeURIComponent(message)}`;
    }
  }

  checkboxes.forEach((cb) => cb.addEventListener("change", updateSummary));
  updateSummary();
</script>

<style>
  .service-detail {
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .service-header {
    max-width: 780px;
    margin-bottom: 3.5rem;
  }

  .service-header h1 {
    font-size: clamp(2.3rem, 4.5vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-block: 0.75rem 1rem;
  }

  .tagline {
    font-size: 1.2rem;
    color: var(--color-ink);
    margin-bottom: 0.85rem;
  }

  .description {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .calculator-layout {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .addons-note {
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .addon-group {
    margin-bottom: 2.25rem;
  }

  .addon-category-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .addon-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .addon-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.1rem 1.25rem;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .addon-card:hover {
    border-color: var(--color-accent);
  }

  .addon-checkbox {
    margin-top: 0.25rem;
    accent-color: var(--color-accent);
  }

  .addon-content {
    flex: 1;
  }

  .addon-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.3rem;
  }

  .addon-title {
    font-weight: 600;
    color: var(--color-ink);
  }

  .addon-price {
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .addon-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .summary-card {
    position: sticky;
    top: 6.5rem;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    padding: 2rem;
  }

  .summary-card h3 {
    font-size: 1.5rem;
    margin-block: 0.4rem 1.5rem;
  }

  .price-breakdown {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .breakdown-row,
  .total-row,
  .monthly-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .total-row {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 1.1rem;
  }

  .total-row strong {
    font-size: 1.45rem;
    color: var(--color-ink);
  }

  .monthly-row {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .monthly-row strong {
    font-size: 1.05rem;
    color: var(--color-accent);
  }

  .selected-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.88rem;
  }

  .selected-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--color-ink);
  }

  .empty-selection {
    color: var(--color-muted) !important;
  }

  .scope-cta {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .calculator-layout {
      grid-template-columns: 1fr;
    }

    .summary-card {
      position: static;
    }
  }
</style>