---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import { services, type Service } from "../../data/services";
import { site } from "../../data/site";

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<Layout
  title={service.title}
  description={service.description}
>
  <Header />

  <main id="main-content">
    <article class="service-detail">
      <header class="detail-hero container">
        <div class="hero-meta">
          <span class="service-number">{service.number}</span>
          <span class="service-category">{service.category}</span>
        </div>
        <h1>{service.title}</h1>
        <p class="hero-desc">{service.longDescription}</p>
        <div class="hero-pricing-badge">
          <span>Starting from</span>
          <strong>₦{service.basePrice.toLocaleString()}</strong>
        </div>
      </header>

      <!-- Interactive Pricing & Scope Calculator -->
      <section class="calculator-section container" id="calculator">
        <div class="calculator-card">
          <div class="calc-header">
            <div>
              <p class="section-label">CUSTOMISE YOUR SCOPE</p>
              <h2>Select your required deliverables</h2>
            </div>
            <p class="calc-intro">
              Pick and choose items from the list below to tailor the scope to your exact needs. Your estimated investment updates instantly.
            </p>
          </div>

          <div class="calc-grid">
            <div class="deliverables-checklist">
              <h3>Included & Optional Items</h3>
              <div class="checkbox-stack">
                {service.pricedDeliverables.map((item) => (
                  <label class="checkbox-item">
                    <input
                      type="checkbox"
                      class="scope-checkbox"
                      value={item.price}
                      data-label={item.label}
                      checked={item.includedByDefault}
                    />
                    <span class="checkbox-custom"></span>
                    <span class="item-text">{item.label}</span>
                    <span class="item-price">₦{item.price.toLocaleString()}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="calc-summary">
              <h3>Investment Summary</h3>
              <div class="summary-breakdown">
                <div class="summary-row">
                  <span>Base Architecture & Strategy</span>
                  <span>₦{service.basePrice.toLocaleString()}</span>
                </div>
                <div class="summary-row">
                  <span>Selected Add-ons Total</span>
                  <span id="addons-total">₦0</span>
                </div>
                <div class="summary-divider"></div>
                <div class="summary-total-row">
                  <span>Estimated Total</span>
                  <strong id="grand-total">₦0</strong>
                </div>
              </div>

              <a
                id="whatsapp-quote-btn"
                class="button calc-cta"
                href={site.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Request this custom scope <span>↗</span>
              </a>
              <p class="calc-note">No obligation. Takes you directly to WhatsApp with your customized breakdown.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="detail-body container">
        <div class="approach-box">
          <h2>Our approach</h2>
          <p>{service.approach}</p>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Layout>

<script define:vars={{ basePrice: service.basePrice, serviceTitle: service.title, whatsappBaseUrl: site.whatsappUrl }}>
  const checkboxes = document.querySelectorAll('.scope-checkbox');
  const addonsTotalEl = document.getElementById('addons-total');
  const grandTotalEl = document.getElementById('grand-total');
  const quoteBtn = document.getElementById('whatsapp-quote-btn');

  function calculateTotal() {
    let addonsSum = 0;
    const selectedItems = [];

    checkboxes.forEach((cb) => {
      if (cb.checked) {
        addonsSum += Number(cb.value);
        selectedItems.push(cb.getAttribute('data-label'));
      }
    });

    const total = basePrice + addonsSum;

    if (addonsTotalEl) addonsTotalEl.textContent = `₦${addonsSum.toLocaleString()}`;
    if (grandTotalEl) grandTotalEl.textContent = `₦${total.toLocaleString()}`;

    if (quoteBtn) {
      const message = `Hello SwishHub, I'd like to commission the "${serviceTitle}" service with a customized scope totaling ₦${total.toLocaleString()}.\n\nSelected deliverables:\n- ${selectedItems.join('\n- ')}`;
      quoteBtn.href = `${whatsappBaseUrl}?text=${encodeURIComponent(message)}`;
    }
  }

  checkboxes.forEach((cb) => {
    cb.addEventListener('change', calculateTotal);
  });

  // Initial calculation on load
  calculateTotal();
</script>

<style>
  .service-detail {
    padding-bottom: 6rem;
  }

  .detail-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--color-line);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .service-number {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .service-category {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .detail-hero h1 {
    max-width: 900px;
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.05em;
  }

  .hero-desc {
    max-width: 700px;
    margin-bottom: 2rem;
    font-size: var(--text-lg);
  }

  .hero-pricing-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.2rem;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .hero-pricing-badge strong {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-accent);
  }

  /* Calculator Section */
  .calculator-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .calculator-card {
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    padding: clamp(2rem, 5vw, 4rem);
    box-shadow: 0 20px 40px rgb(23 19 15 / 4%);
  }

  .calc-header {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .calc-header h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin-top: 0.5rem;
  }

  .calc-intro {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 4rem;
    align-items: start;
  }

  .deliverables-checklist h3,
  .calc-summary h3 {
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
  }

  .checkbox-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .checkbox-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    cursor: pointer;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .checkbox-item:hover {
    border-color: var(--color-accent);
  }

  .checkbox-item input {
    accent-color: var(--color-accent);
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .item-text {
    flex-grow: 1;
    margin-inline: 1rem;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .item-price {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .calc-summary {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    padding: 2.5rem;
  }

  .summary-breakdown {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .summary-divider {
    height: 1px;
    background: var(--color-line);
    margin-block: 0.5rem;
  }

  .summary-total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-ink);
  }

  .summary-total-row strong {
    font-size: 1.8rem;
    color: var(--color-accent);
  }

  .calc-cta {
    width: 100%;
    justify-content: center;
    text-align: center;
    margin-bottom: 1rem;
  }

  .calc-note {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-align: center;
    margin: 0;
  }

  .detail-body {
    padding-top: 5rem;
  }

  .approach-box h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  .approach-box p {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 800px;
  }

  @media (max-width: 900px) {
    .calc-header,
    .calc-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>