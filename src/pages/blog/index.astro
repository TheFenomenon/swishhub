---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import { blogPosts } from "../../data/posts";
---

<Layout
  title="Editorial Blog & Insights"
  description="Read essays, case studies, and practical thoughts on web design, content strategy, and digital growth from SwishHub Interactive."
>
  <Header />

  <main id="main-content">
    <section class="blog-index container">
      <div class="index-header">
        <p class="section-label">EDITORIAL INSIGHTS</p>
        <h1>Thoughts on design, copy, and digital commerce.</h1>
        <p class="index-intro">
          No fluff, no corporate buzzwords. Just practical frameworks and design philosophies that help growing businesses win online.
        </p>
      </div>

      <div class="posts-stack">
        {blogPosts.map((post) => (
          <article class="post-card">
            <div class="post-meta">
              <span class="post-category">{post.category}</span>
              <span>•</span>
              <span>{post.date}</span>
              <span>•</span>
              <span>{post.readTime}</span>
            </div>
            <h2>
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h2>
            <p>{post.description}</p>
            <a href={`/blog/${post.slug}/`} class="read-more">
              Read article <span>↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .blog-index {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .index-header {
    max-width: 800px;
    margin-bottom: 4rem;
  }

  .index-header h1 {
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    margin-block: 1rem;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .index-intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .posts-stack {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 900px;
  }

  .post-card {
    padding: 2.5rem;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .post-category {
    color: var(--color-accent);
  }

  .post-card h2 {
    font-size: clamp(1.75rem, 3vw, 2.2rem);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .post-card h2 a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .post-card h2 a:hover {
    color: var(--color-accent);
  }

  .post-card p {
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .read-more:hover {
    color: var(--color-accent);
  }
</style>