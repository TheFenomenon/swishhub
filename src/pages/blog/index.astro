---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import { getPublishedPosts } from "../../lib/blog-data";

export const prerender = false;

const posts = await getPublishedPosts();
---

<Layout
  title="Blog & Insights — SwishHub Interactive Limited"
  description="Practical notes on building websites that sell, conversion strategy, content systems, and digital growth."
>
  <Header />

  <main id="main-content">
    <section class="blog-index container">
      <div class="blog-header">
        <p class="section-label">EDITORIAL & INSIGHTS</p>
        <h1>Notes on <em>websites that sell</em> & real growth.</h1>
        <p class="blog-lead">
          Straightforward breakdowns on messaging, conversion architecture, content cadence, and turning attention into paying clients.
        </p>
      </div>

      <div class="posts-grid">
        {posts.map((post) => (
          <article class="post-card">
            <div class="post-meta">
              <span class="post-cat">{post.category}</span>
              <span>•</span>
              <span>{post.dateLabel}</span>
              <span>•</span>
              <span>{post.readTime}</span>
            </div>

            <h2>
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>

            <p class="post-excerpt">{post.excerpt}</p>

            <a href={`/blog/${post.slug}`} class="read-more">
              Read article <span>→</span>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .blog-index {
    padding-block: clamp(4rem, 8vw, 7.5rem);
  }

  .blog-header {
    max-width: 820px;
    margin-bottom: 3.5rem;
  }

  .blog-header h1 {
    font-size: clamp(2.4rem, 4.8vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-block: 1rem 1.25rem;
  }

  .blog-header h1 em {
    color: var(--color-accent);
    font-weight: 400;
  }

  .blog-lead {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.65;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .post-card {
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.9rem;
  }

  .post-cat {
    color: var(--color-accent);
  }

  .post-card h2 {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 0.85rem;
  }

  .post-card h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .post-card h2 a:hover {
    color: var(--color-accent);
  }

  .post-excerpt {
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .read-more {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
  }

  .read-more:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>