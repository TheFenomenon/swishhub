---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import { blogPosts, type BlogPost } from "../../data/posts";
import { site } from "../../data/site";

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<Layout title={post.title} description={post.description}>
  <Header />

  <main id="main-content">
    <article class="blog-post container">
      <header class="post-header">
        <div class="post-meta">
          <span class="post-category">{post.category}</span>
          <span>•</span>
          <span>{post.date}</span>
          <span>•</span>
          <span>{post.readTime}</span>
        </div>
        <h1>{post.title}</h1>
        <p class="post-lead">{post.description}</p>
      </header>

      <div class="post-body">
        {post.content.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <footer class="post-footer">
        <div class="author-box">
          <h3>SwishHub Interactive</h3>
          <p>We build digital experiences that move business forward. Let's discuss your next project.</p>
          <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="button">
            Start a conversation via WhatsApp <span>↗</span>
          </a>
        </div>
      </footer>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .blog-post {
    max-width: 800px;
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-line);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  .post-category {
    color: var(--color-accent);
  }

  .post-header h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .post-lead {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-ink);
  }

  .post-body p {
    margin: 0;
  }

  .post-footer {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-line);
  }

  .author-box {
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    padding: 3rem;
  }

  .author-box h3 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .author-box p {
    font-size: 1.05rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }
</style>