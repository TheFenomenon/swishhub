---
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import { services } from "../data/services";
import { site } from "../data/site";
---

<Layout
  title="Contact"
  description="Start a project with SwishHub Interactive Limited. Tell us about your business goals, timeline, and required deliverables."
>
  <Header />

  <main id="main-content">
    <section class="contact-page container">
      <div class="contact-grid">
        <!-- Left Column: Editorial Intro & Direct Channels -->
        <div class="contact-info">
          <p class="section-label">START A CONVERSATION</p>
          <h1>Let’s build something that <em>moves your business forward.</em></h1>
          <p class="lead">
            Whether you need a conversion-focused website, sharper brand copy, or a full content system, tell us where you are right now and where you want to go.
          </p>

          <div class="direct-channels">
            <div class="channel-block">
              <span class="channel-label">DIRECT WHATSAPP</span>
              <a
                href={site.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="channel-link"
              >
                0704 026 5312 <span>↗</span>
              </a>
              <p class="channel-note">Fastest response during business hours (Mon – Sat).</p>
            </div>

            <div class="channel-block">
              <span class="channel-label">HEADQUARTERS</span>
              <p class="channel-text">Nigeria · Serving clients worldwide</p>
            </div>

            <div class="channel-block">
              <span class="channel-label">HOW WE WORK</span>
              <p class="channel-text">
                1. Brief review & discovery call<br />
                2. Clear scope & fixed timeline<br />
                3. Focused execution & launch
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Project Brief Builder -->
        <div class="brief-card">
          <div class="brief-header">
            <h2>Project Brief</h2>
            <p>Fill out the details below to generate a structured brief and open a direct WhatsApp chat with our team.</p>
          </div>

          <form id="project-brief-form" class="brief-form">
            <div class="form-row">
              <div class="form-group">
                <label for="client-name">Your Name *</label>
                <input
                  type="text"
                  id="client-name"
                  name="name"
                  placeholder="e.g. Chinedu Okafor"
                  required
                />
              </div>

              <div class="form-group">
                <label for="business-name">Business / Brand Name</label>
                <input
                  type="text"
                  id="business-name"
                  name="business"
                  placeholder="e.g. Apex Logistics Ltd"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="service-select">Primary Service Needed *</label>
              <select id="service-select" name="service" required>
                <option value="" disabled selected>Select a service...</option>
                {services.map((service) => (
                  <option value={service.title}>
                    {service.title} (From ₦{service.basePrice.toLocaleString()})
                  </option>
                ))}
                <option value="Multiple Services / Custom Retainer">
                  Multiple Services / Custom Retainer
                </option>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="budget-select">Estimated Budget Range</label>
                <select id="budget-select" name="budget">
                  <option value="Not sure yet">Not sure yet — advise me</option>
                  <option value="₦70,000 – ₦150,000">₦70,000 – ₦150,000</option>
                  <option value="₦150,000 – ₦350,000">₦150,000 – ₦350,000</option>
                  <option value="₦350,000 – ₦750,000">₦350,000 – ₦750,000</option>
                  <option value="₦750,000+">₦750,000+</option>
                </select>
              </div>

              <div class="form-group">
                <label for="timeline-select">Target Timeline</label>
                <select id="timeline-select" name="timeline">
                  <option value="Flexible">Flexible</option>
                  <option value="Urgent (Within 2 weeks)">Urgent (Within 2 weeks)</option>
                  <option value="2 – 4 weeks">2 – 4 weeks</option>
                  <option value="1 – 2 months">1 – 2 months</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="project-goals">Project Goals & Context *</label>
              <textarea
                id="project-goals"
                name="goals"
                rows="4"
                placeholder="Briefly describe what you're building, the problem you want to solve, or any links to your current website/socials..."
                required
              ></textarea>
            </div>

            <button type="submit" class="button submit-btn">
              Send brief via WhatsApp <span>↗</span>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script define:vars={{ whatsappBaseUrl: site.whatsappUrl }}>
  const form = document.getElementById("project-brief-form");

  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get("name")?.toString().trim() || "Not specified";
      const business = formData.get("business")?.toString().trim() || "Not specified";
      const service = formData.get("service")?.toString().trim() || "General Inquiry";
      const budget = formData.get("budget")?.toString().trim() || "Not specified";
      const timeline = formData.get("timeline")?.toString().trim() || "Flexible";
      const goals = formData.get("goals")?.toString().trim() || "";

      const message = [
        `Hello SwishHub, I'd like to start a new project.`,
        ``,
        `*Name:* ${name}`,
        `*Business:* ${business}`,
        `*Service:* ${service}`,
        `*Budget:* ${budget}`,
        `*Timeline:* ${timeline}`,
        ``,
        `*Project Goals:*`,
        `${goals}`
      ].join("\n");

      const targetUrl = `${whatsappBaseUrl}?text=${encodeURIComponent(message)}`;
      window.open(targetUrl, "_blank", "noopener,noreferrer");
    });
  }
</script>

<style>
  .contact-page {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .contact-info h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin-block: 1rem 1.5rem;
  }

  .contact-info h1 em {
    color: var(--color-accent);
    font-weight: 400;
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 3rem;
  }

  .direct-channels {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .channel-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .channel-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  .channel-link {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color var(--transition-fast);
  }

  .channel-link:hover {
    color: var(--color-accent);
  }

  .channel-note,
  .channel-text {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Brief Card & Form */
  .brief-card {
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    padding: clamp(2rem, 4vw, 3.5rem);
    box-shadow: 0 20px 40px rgb(23 19 15 / 4%);
  }

  .brief-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .brief-header h2 {
    font-size: 1.85rem;
    margin-bottom: 0.5rem;
  }

  .brief-header p {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin: 0;
  }

  .brief-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 110px;
  }

  .submit-btn {
    width: 100%;
    justify-content: center;
    margin-top: 0.5rem;
    cursor: pointer;
    border: none;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>