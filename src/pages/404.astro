
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import { site } from "../data/site";
---

<Layout
  title="Page Not Found"
  description="The page you're looking for could not be found. Return to SwishHub's homepage."
>
  <Header />

  <main id="main-content" class="error-page">
    <div class="container">
      <p class="section-label">ERROR 404</p>

      <h1>
        Looks like this
        <em>page took a wrong turn.</em>
      </h1>

      <p class="error-description">
        The page you're looking for may have moved, been removed
        or never existed. No worries. Let's get you back on track.
      </p>

      <div class="error-actions">
        <a href="/" class="button">Back to homepage ↗</a>
        <a
          href={site.whatsappUrl}
          class="button button--outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Contact SwishHub
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .error-page {
    display: flex;
    min-height: 65vh;
    align-items: center;
    padding-block: 5rem;
  }

  .error-page h1 {
    max-width: 950px;
    margin-bottom: 1.5rem;
    font-size: var(--text-display);
    letter-spacing: -0.065em;
  }

  .error-page h1 em {
    display: block;
    color: var(--color-accent);
    font-weight: 400;
  }

  .error-description {
    max-width: 580px;
    font-size: var(--text-lg);
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
