---
import Layout from "../../layouts/Layout.astro";
import { getSql } from "../../lib/db";

export const prerender = false;

interface DbPost {
  id: number;
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  read_time: string;
  status: string;
  created_at: string;
}

let existingPosts: DbPost[] = [];
try {
  const sql = getSql();
  existingPosts = (await sql`
    SELECT id, slug, title, excerpt, category, read_time, status, created_at
    FROM blog_posts
    ORDER BY created_at DESC
  `) as DbPost[];
} catch {
  existingPosts = [];
}
---

<Layout
  title="Blog Publisher — SwishHub Admin"
  description="Create and manage blog articles."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main class="pub-wrap container">
    <header class="pub-header">
      <div>
        <p class="section-label">EDITORIAL STUDIO</p>
        <h1>Blog Publisher</h1>
        <p class="pub-sub">
          Write articles, save drafts, or publish directly to your live blog.
        </p>
      </div>
      <div class="pub-actions">
        <a href="/admin" class="button button-ghost">← Dashboard</a>
        <a href="/blog/" class="button button-ghost">View Public Blog</a>
      </div>
    </header>

    <div class="pub-grid">
      <section class="editor-panel">
        <h2>New Article</h2>
        <p class="hint">
          Separate paragraphs with a blank line. Start a line with <code>## </code> for subheadings or <code>- </code> for bullet points.
        </p>

        <form id="postForm" class="post-form">
          <div class="field">
            <label for="title">Article Title *</label>
            <input
              type="text"
              id="title"
              name="title"
              required
              placeholder="e.g., Why Most Nigerian Business Websites Don't Close Sales"
            />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="category">Category *</label>
              <input
                type="text"
                id="category"
                name="category"
                required
                value="Conversion & Sales"
              />
            </div>

            <div class="field">
              <label for="status">Status</label>
              <select id="status" name="status">
                <option value="published">Published (Live immediately)</option>
                <option value="draft">Draft (Saved privately)</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="slug">Custom URL Slug (optional)</label>
            <input
              type="text"
              id="slug"
              name="slug"
              placeholder="auto-generated-from-title-if-left-blank"
            />
          </div>

          <div class="field">
            <label for="excerpt">Excerpt / Summary *</label>
            <textarea
              id="excerpt"
              name="excerpt"
              rows="2"
              required
              placeholder="Short 1–2 sentence summary shown on blog cards and meta descriptions."
            ></textarea>
          </div>

          <div class="field">
            <label for="content">Article Body *</label>
            <textarea
              id="content"
              name="content"
              rows="12"
              required
              placeholder="Write your article here..."
            ></textarea>
          </div>

          <p id="formMessage" class="form-msg" role="status" hidden></p>

          <button type="submit" class="button" id="submitPostBtn">
            Save & Publish Article
          </button>
        </form>
      </section>

      <aside class="posts-panel">
        <h2>Saved Articles ({existingPosts.length})</h2>

        {existingPosts.length === 0 ? (
          <p class="empty-text">No database articles created yet.</p>
        ) : (
          <ul class="post-list" id="postList">
            {existingPosts.map((p) => (
              <li class="post-row" data-id={p.id}>
                <div class="post-row-top">
                  <span class={`status-pill ${p.status === "published" ? "is-live" : ""}`}>
                    {p.status}
                  </span>
                  <span class="cat-tag">{p.category}</span>
                </div>
                <h3>{p.title}</h3>
                <p class="slug-line"><code>/blog/{p.slug}</code> • {p.read_time}</p>
                <div class="row-actions">
                  {p.status === "published" && (
                    <a href={`/blog/${p.slug}`} target="_blank" rel="noopener noreferrer">
                      Open live ↗
                    </a>
                  )}
                  <button
                    type="button"
                    class="delete-btn"
                    data-delete-id={p.id}
                  >
                    Delete
                  </button>
                </div>
              </li>
            ))}
          </ul>
        )}
      </aside>
    </div>
  </main>
</Layout>

<style>
  .pub-wrap {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .pub-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 2.25rem;
  }

  .pub-header h1 {
    font-size: clamp(2rem, 3.8vw, 3rem);
    letter-spacing: -0.03em;
    margin-block: 0.5rem 0.4rem;
  }

  .pub-sub,
  .hint,
  .empty-text {
    color: var(--color-muted);
  }

  .pub-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button-ghost {
    background: transparent !important;
    color: var(--color-ink) !important;
    border: 1px solid var(--color-line) !important;
  }

  .pub-grid {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .editor-panel,
  .posts-panel {
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .editor-panel h2,
  .posts-panel h2 {
    font-size: 1.35rem;
    margin: 0 0 0.5rem;
  }

  .post-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 1.25rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .field input,
  .field select,
  .field textarea {
    padding: 0.75rem 0.9rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: inherit;
    font-size: 0.96rem;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-msg {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .form-msg.ok {
    color: #1f7a4c;
  }

  .form-msg.err {
    color: #b42318;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-row {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    padding: 1rem 1.1rem;
  }

  .post-row-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.45rem;
    font-size: 0.76rem;
  }

  .status-pill {
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .status-pill.is-live {
    border-color: #1f7a4c;
    color: #1f7a4c;
  }

  .cat-tag {
    color: var(--color-accent);
    font-weight: 600;
  }

  .post-row h3 {
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
  }

  .slug-line {
    font-size: 0.82rem;
    color: var(--color-muted);
    margin: 0 0 0.65rem;
  }

  .slug-line code {
    background: var(--color-paper-deep);
    padding: 0.1rem 0.35rem;
  }

  .row-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
  }

  .row-actions a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .delete-btn {
    background: none;
    border: none;
    color: #b42318;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .pub-grid,
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById("postForm") as HTMLFormElement | null;
  const msgEl = document.getElementById("formMessage");
  const submitBtn = document.getElementById("submitPostBtn") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!msgEl || !submitBtn) return;

    msgEl.hidden = true;
    msgEl.className = "form-msg";
    submitBtn.disabled = true;
    submitBtn.textContent = "Saving...";

    const fd = new FormData(form);
    const payload = {
      title: fd.get("title"),
      category: fd.get("category"),
      status: fd.get("status"),
      slug: fd.get("slug"),
      excerpt: fd.get("excerpt"),
      content: fd.get("content"),
    };

    try {
      const res = await fetch("/api/admin/posts", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) {
        msgEl.textContent = data.error || "Could not save article.";
        msgEl.classList.add("err");
        msgEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = "Save & Publish Article";
        return;
      }

      msgEl.textContent = `Saved "${data.post.title}" (${data.post.status}). Reloading list...`;
      msgEl.classList.add("ok");
      msgEl.hidden = false;
      window.location.reload();
    } catch {
      msgEl.textContent = "Network error while saving article.";
      msgEl.classList.add("err");
      msgEl.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = "Save & Publish Article";
    }
  });

  document.querySelectorAll<HTMLButtonElement>("[data-delete-id]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.deleteId;
      if (!id) return;
      if (!window.confirm("Delete this blog post permanently?")) return;

      const res = await fetch(`/api/admin/posts?id=${encodeURIComponent(id)}`, {
        method: "DELETE",
      });
      if (res.ok) {
        window.location.reload();
      }
    });
  });
</script>