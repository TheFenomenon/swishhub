
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import ApproachSection from "../components/sections/ApproachSection.astro";
import { site } from "../data/site";
---

<Layout
  title="About Us"
  description="Discover the thinking behind SwishHub Interactive Limited and how we bring sales strategy, creativity and technology together."
>
  <Header />

  <main id="main-content">
    <section class="about-hero container">
      <p class="section-label">WHO WE ARE</p>

      <h1>
        We build with
        <em>business in mind.</em>
      </h1>

      <p class="about-intro">
        SwishHub Interactive Limited is built around a simple belief:
        digital experiences should create value for the businesses
        behind them and the people they serve.
      </p>

      <a
        class="button"
        href={site.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Start a conversation <span aria-hidden="true">↗</span>
      </a>
    </section>

    <AboutSection />
    <ApproachSection />

    <section class="about-belief">
      <div class="container">
        <p class="section-label">WHAT GUIDES OUR WORK</p>
        <h2>
          The goal isn't to make more digital noise.
          It's to make every interaction count.
        </h2>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-hero {
    padding-block: clamp(6rem, 13vw, 11rem);
  }

  .about-hero h1 {
    max-width: 1000px;
    margin-bottom: 2rem;
    font-size: var(--text-display);
    letter-spacing: -0.065em;
  }

  .about-hero h1 em {
    display: block;
    color: var(--color-accent);
    font-weight: 400;
  }

  .about-intro {
    max-width: 680px;
    margin-bottom: 2.5rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .about-belief {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: var(--color-paper-deep);
  }

  .about-belief h2 {
    max-width: 950px;
    margin-bottom: 0;
    font-size: clamp(2.5rem, 5.5vw, 5rem);
  }
</style>
