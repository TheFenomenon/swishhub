
---
import ContactSection from "../components/sections/ContactSection.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import ApproachSection from "../components/sections/ApproachSection.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import { site } from "../data/site";
---

<Layout title="Home">
  <Header />

  <main id="main-content">
    <section class="hero container">
      <p class="eyebrow">STRATEGY · CREATIVITY · TECHNOLOGY</p>

      <h1>
        Good businesses deserve
        <em>better digital experiences.</em>
      </h1>

      <p class="hero-description">
        We help businesses attract attention, build trust and turn
        digital experiences into meaningful action.
      </p>

      <div class="hero-actions">
        <a
          class="button"
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Start a project <span aria-hidden="true">↗</span>
        </a>

        <a class="button button--outline" href="#services">
          Explore our services
        </a>
      </div>
    </section>

    <ServicesSection />
	<ApproachSection />

    <AboutSection />
      <div class="container">
        <p class="section-label">ABOUT SWISHHUB</p>
        <h2>We believe digital should do more than look good.</h2>
        <p>
          Every digital touchpoint should help people understand
          your business, trust what you offer and know what to do next.
        </p>
      </div>
   

    <ContactSection />
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    padding-block: clamp(6rem, 13vw, 11rem);
  }

  .eyebrow {
    margin-bottom: 2rem;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .hero h1 {
    max-width: 1000px;
    margin-bottom: 2rem;
    font-size: var(--text-display);
    letter-spacing: -0.065em;
  }

  .hero h1 em {
    display: block;
    color: var(--color-accent);
    font-weight: 400;
  }

  .hero-description {
    max-width: 590px;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .intro-section {
    padding-block: var(--space-9);
    border-top: 1px solid var(--color-line);
  }

  .intro-section h2 {
    max-width: 760px;
    margin-bottom: 1.5rem;
    font-size: clamp(2.2rem, 5vw, 4rem);
  }

  .intro-section .container > p:not(.section-label) {
    max-width: 650px;
    font-size: var(--text-lg);
  }

  .about-section {
    background: var(--color-paper-deep);
  }

  .contact-section {
    padding-block: var(--space-10);
  }

  .contact-section .button {
    margin-top: 1rem;
  }
</style>
