---
import ContactSection from "../components/sections/ContactSection.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import ApproachSection from "../components/sections/ApproachSection.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import { site } from "../data/site";
---

<Layout title="Home">
  <Header />

  <main id="main-content">
    <section class="hero container">
      <div class="hero-content">
        <p class="eyebrow">STRATEGY · CREATIVITY · TECHNOLOGY</p>

        <h1>
          Good businesses deserve
          <em>better digital experiences.</em>
        </h1>

        <p class="hero-description">
          We help businesses attract attention, build trust and turn
          digital experiences into meaningful action.
        </p>

        <div class="hero-actions">
          <a
            class="button"
            href={site.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Start a project <span aria-hidden="true">↗</span>
          </a>

          <a class="button button--outline" href="#services">
            Explore our services
          </a>
        </div>
      </div>

      <!-- Minimalist 3D Architectural Line-Art Illustration -->
      <div class="hero-visual" aria-hidden="true">
        <div class="iso-stage">
          <!-- Base Grid Plane: 01 Attention -->
          <div class="iso-plane plane-1">
            <div class="plane-header">
              <span>01</span>
              <span>ATTENTION</span>
            </div>
            <svg class="plane-svg" viewBox="0 0 280 180" fill="none">
              <circle cx="140" cy="90" r="68" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 3" />
              <circle cx="140" cy="90" r="36" stroke="currentColor" stroke-width="0.75" />
              <line x1="20" y1="90" x2="260" y2="90" stroke="currentColor" stroke-width="0.6" />
              <line x1="140" y1="12" x2="140" y2="168" stroke="currentColor" stroke-width="0.6" />
              <circle cx="140" cy="90" r="3.5" fill="#B23A0E" />
            </svg>
          </div>

          <!-- Middle Architectural Plane: 02 Trust -->
          <div class="iso-plane plane-2">
            <div class="plane-header">
              <span>02</span>
              <span>TRUST</span>
            </div>
            <svg class="plane-svg" viewBox="0 0 280 180" fill="none">
              <rect x="44" y="32" width="192" height="116" stroke="currentColor" stroke-width="0.75" />
              <line x1="44" y1="64" x2="236" y2="64" stroke="currentColor" stroke-width="0.75" />
              <line x1="108" y1="64" x2="108" y2="148" stroke="currentColor" stroke-width="0.75" />
              <circle cx="60" cy="48" r="2.5" fill="#B23A0E" />
              <circle cx="70" cy="48" r="2.5" fill="currentColor" />
            </svg>
          </div>

          <!-- Top Vector Plane: 03 Action -->
          <div class="iso-plane plane-3">
            <div class="plane-header">
              <span>03</span>
              <span class="accent-label">ACTION ↗</span>
            </div>
            <svg class="plane-svg" viewBox="0 0 280 180" fill="none">
              <path d="M56 132 L132 84 L176 102 L228 46" stroke="#B23A0E" stroke-width="1.4" />
              <circle cx="56" cy="132" r="3" fill="#17130F" />
              <circle cx="132" cy="84" r="3" fill="#17130F" />
              <circle cx="176" cy="102" r="3" fill="#17130F" />
              <circle cx="228" cy="46" r="4.5" fill="#B23A0E" />
            </svg>
          </div>
        </div>
      </div>
    </section>

    <ServicesSection />
    <ApproachSection />
    <AboutSection />
    <ContactSection />
  </main>

  <Footer />
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes subtleFloat {
    0%, 100% {
      transform: rotateX(48deg) rotateZ(-36deg) translateY(0px);
    }
    50% {
      transform: rotateX(46deg) rotateZ(-34deg) translateY(-8px);
    }
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 3rem;
    padding-block: clamp(5rem, 11vw, 9.5rem);
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .eyebrow {
    margin-bottom: 1.5rem;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .hero h1 {
    max-width: 680px;
    margin-bottom: 1.5rem;
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    letter-spacing: -0.065em;
    line-height: 1.05;
  }

  .hero h1 em {
    display: block;
    color: var(--color-accent);
    font-weight: 400;
  }

  .hero-description {
    max-width: 520px;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  /* Minimalist 3D Isometric Line Illustration */
  .hero-visual {
    perspective: 1200px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 400px;
  }

  .iso-stage {
    position: relative;
    width: 300px;
    height: 210px;
    transform-style: preserve-3d;
    transform: rotateX(48deg) rotateZ(-36deg);
    animation: subtleFloat 7s ease-in-out infinite;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-visual:hover .iso-stage {
    animation-play-state: paused;
    transform: rotateX(42deg) rotateZ(-28deg) scale(1.03);
  }

  .iso-plane {
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-line);
    background: rgb(245 241 234 / 72%);
    backdrop-filter: blur(2px);
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--color-ink);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
  }

  .plane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-muted);
  }

  .accent-label {
    color: var(--color-accent);
  }

  .plane-svg {
    width: 100%;
    height: auto;
    color: var(--color-muted);
    opacity: 0.85;
  }

  .plane-1 {
    transform: translateZ(0px);
  }

  .plane-2 {
    transform: translateZ(54px);
    border-color: rgb(23 19 15 / 22%);
  }

  .plane-3 {
    transform: translateZ(108px);
    border-color: var(--color-accent);
    background: rgb(245 241 234 / 82%);
  }

  .hero-visual:hover .plane-2 {
    transform: translateZ(72px);
  }

  .hero-visual:hover .plane-3 {
    transform: translateZ(144px);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-visual {
      min-height: 310px;
    }

    .iso-stage {
      width: 250px;
      height: 175px;
    }
  }
</style>