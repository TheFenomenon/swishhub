---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/site/Header.astro";
import Footer from "../../components/site/Footer.astro";
import { projects } from "../../data/projects";
import { site } from "../../data/site";
---

<Layout
  title="Selected Work & Case Studies"
  description="Explore selected web builds, content systems, and conversion funnels crafted by SwishHub Interactive Limited."
>
  <Header />

  <main id="main-content">
    <section class="work-index container">
      <div class="work-header">
        <p class="section-label">SELECTED WORK</p>
        <h1>Proof built around <em>clarity and conversion</em>.</h1>
        <p class="work-lead">
          A look at how we structure websites, content assets, and inquiry flows so visitors understand your value and take action.
        </p>
      </div>

      <div class="projects-grid">
        {projects.map((project, index) => (
          <article class="project-card">
            <div class="project-meta">
              <span class="project-num">0{index + 1}</span>
              <span>•</span>
              <span class="project-cat">{project.category}</span>
              <span>•</span>
              <span>{project.location}</span>
            </div>

            <h2>
              <a href={`/work/${project.slug}/`}>{project.title}</a>
            </h2>
            <p class="project-client">Client / Context: <strong>{project.client}</strong></p>
            <p class="project-summary">{project.summary}</p>

            <ul class="deliverables-list">
              {project.deliverables.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <a href={`/work/${project.slug}/`} class="read-case">
              Read case study <span>↗</span>
            </a>
          </article>
        ))}
      </div>

      <div class="work-bottom-cta">
        <h2>Want results like these for your business?</h2>
        <p>Tell us what you're building and we'll map out a practical, conversion-focused plan.</p>
        <div class="cta-actions">
          <a href="/contact/" class="button">Start a Project Brief</a>
          <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="button button-secondary">
            Chat on WhatsApp <span>↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .work-index {
    padding-block: clamp(4rem, 8vw, 7.5rem);
  }

  .work-header {
    max-width: 820px;
    margin-bottom: 4rem;
  }

  .work-header h1 {
    font-size: clamp(2.4rem, 4.8vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-block: 1rem 1.25rem;
  }

  .work-header h1 em {
    color: var(--color-accent);
    font-weight: 400;
  }

  .work-lead {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.65;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    max-width: 960px;
  }

  .project-card {
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    padding: clamp(2rem, 4vw, 3rem);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .project-num,
  .project-cat {
    color: var(--color-accent);
  }

  .project-card h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.35rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .project-card h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .project-card h2 a:hover {
    color: var(--color-accent);
  }

  .project-client {
    font-size: 0.92rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .project-client strong {
    color: var(--color-ink);
  }

  .project-summary {
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .deliverables-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .deliverables-list li {
    font-size: 0.82rem;
    padding: 0.35rem 0.75rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .read-case {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
  }

  .read-case:hover {
    color: var(--color-accent);
  }

  .work-bottom-cta {
    margin-top: 5rem;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-line);
    padding: clamp(2.5rem, 5vw, 4rem);
    max-width: 960px;
  }

  .work-bottom-cta h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .work-bottom-cta p {
    color: var(--color-muted);
    font-size: 1.05rem;
    margin-bottom: 1.75rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .button-secondary {
    background: transparent !important;
    color: var(--color-ink) !important;
    border: 1px solid var(--color-line) !important;
  }

  .button-secondary:hover {
    border-color: var(--color-accent) !important;
    color: var(--color-accent) !important;
  }
</style>